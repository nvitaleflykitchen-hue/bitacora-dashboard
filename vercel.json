{
  "installCommand": "npm install --no-package-lock",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/product-resolver.js": {
      "maxDuration": 60
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/mcp-oauth.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/mcp/connect",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/authorize",
      "destination": "/api/mcp-oauth?mcp_route=%2Fauthorize"
    },
    {
      "source": "/token",
      "destination": "/api/mcp-oauth?mcp_route=%2Ftoken"
    },
    {
      "source": "/register",
      "destination": "/api/mcp-oauth?mcp_route=%2Fregister"
    },
    {
      "source": "/revoke",
      "destination": "/api/mcp-oauth?mcp_route=%2Frevoke"
    },
    {
      "source": "/api/mcp-consent",
      "destination": "/api/mcp-oauth?mcp_route=%2Fapi%2Fmcp-consent"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp-oauth?mcp_route=%2F.well-known%2Foauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp-oauth?mcp_route=%2F.well-known%2Foauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/mcp-oauth?mcp_route=%2F.well-known%2Foauth-protected-resource%2Fapi%2Fmcp"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

{
  "name": "bitacora-dashboard",
  "private": true,
  "version": "2.9.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run && npm run test:accesos && npm run test:mcp",
    "test:accesos": "node scripts/verify-credential-v11.mjs ./node_modules/@electric-sql/pglite/dist/index.js",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "predeploy:check": "node scripts/predeploy-check.mjs",
    "deploy:prod": "npm run predeploy:check && npm run check && npx vercel --prod --yes",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall.cjs",
    "mcp:dev": "node --env-file=.env.mcp.local scripts/mcp-local.mjs",
    "mcp:smoke": "node --env-file=.env.mcp.local scripts/mcp-smoke.mjs",
    "test:mcp": "node --test tests/mcp.test.mjs tests/mcp-oauth.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@supabase/supabase-js": "^2.45.0",
    "@xyflow/react": "12.11.2",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "cheerio": "1.2.0",
    "core-js": "^3.49.0",
    "date-fns": "^3.6.0",
    "docx": "^8.5.0",
    "express": "5.2.1",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "^0.383.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "xlsx": "0.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "8.1.4",
    "vitest": "^3.2.6"
  }
}
